# Leave the Supabase values empty to run in demo mode. No secrets required.
# Demo bookings stay in the browser. The sample clinic is Whitmore Dental.

# demo | supabase. Omit this and demo mode turns on when the URL below is empty.
NEXT_PUBLIC_DATA_MODE=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used inside reminder links. Falls back to the request host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production so Vercel Cron and n8n can call the reminder routes.
# Demo mode accepts the default demo-cron-secret when this is empty.
CRON_SECRET=

# Demo desk login. The sign-in page shows these defaults.
# Changing them does not update the hint unless you rebuild.
DEMO_STAFF_EMAIL=staff@whitmore.dental
DEMO_STAFF_PASSWORD=whitmore-demo

# Signs the demo session cookie. The default is fine for the sample clinic only.
DEMO_SESSION_SECRET=
